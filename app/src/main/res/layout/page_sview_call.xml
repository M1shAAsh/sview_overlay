<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B22F81B6">

    <!-- Информация о звонке сверху -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentTop="true"
        android:background="#009B4C"
        android:gravity="start"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="14dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/sview_call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/sview_incoming_call"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Chronometer
            android:id="@+id/sview_call_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sview_caller_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/sview_unknown_number"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/sview_caller_photo"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_tw_step_btn"
        android:importantForAccessibility="no"
        android:padding="6dp"
        android:scaleType="centerCrop"
        android:src="@drawable/call_unknown_person" />


    <!-- Панель кнопок управления внизу -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <!-- Кнопка 1 (только при входящем): Ответить -->
        <ImageView
            android:id="@+id/btn_call_answer"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="78dp"
            android:background="@drawable/call_circle_receive_01"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="no"
            android:padding="14dp"
            android:scaleType="fitCenter" />

        <!-- Кнопка 2 (во время разговора): Громкая связь (Динамик) -->
        <ImageView
            android:id="@+id/btn_call_speaker"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/during_call_btn_speaker_normal"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Кнопка 3 (во время разговора): Отключение микрофона (Mute) -->
        <ImageView
            android:id="@+id/btn_call_mute"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/during_call_btn_mute_normal"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Кнопка 4 (всегда): Сбросить / Завершить вызов -->
        <ImageView
            android:id="@+id/btn_call_reject"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/call_circle_reject_01"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="no"
            android:padding="14dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

</RelativeLayout>
